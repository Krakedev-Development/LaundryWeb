{
  "name": "laundry-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "domain:sync": "node scripts/sync-app-domain.cjs",
    "domain:check": "node scripts/sync-app-domain.cjs",
    "test:app": "playwright test --config playwright.app.config.cjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@zxing/browser": "^0.2.1",
    "lucide-react": "^0.546.0",
    "mapbox-gl": "^3.32.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
