# Tokens públicos separados para Web y App. No usar tokens secretos.
VITE_MAPBOX_PUBLIC_TOKEN=
# demo: escenarios locales y estimaciones explícitas; mapbox: APIs reales.
VITE_GEO_MODE=demo
# Activar solamente cuando la cuenta permita geocodificación permanente.
VITE_MAPBOX_PERMANENT_GEOCODING=false
VITE_APP_COUNTRY=EC
VITE_APP_MAP_LANGUAGE=es
VITE_APP_DEFAULT_LATITUDE=-2.124
VITE_APP_DEFAULT_LONGITUDE=-79.869
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
VITE_USE_BACKEND_GEO=false
VITE_TRACKING_MODE=mock
VITE_GEO_API_URL=
